# RUN SETTINGS: edit here, then start the demo UI (app/run_demo.ps1) or the dataset job on the cluster
# (jobs/anonymize_dataset.sbatch). One KEY=VALUE per line; an empty value means the built-in default.
#
# Order of precedence, last wins: built-in default < this file < configs/run.local.env < exported variable (cluster
# job) < command-line flag. Put settings that belong to ONE machine (its paths, a small GPU) in configs/run.local.env:
# that file is not in the repository, so a clone keeps these shared defaults.
# The model and its settings per pipeline (checkpoint, target rule, steps, guidance, prompt) live in
# configs/pipelines/<name>.env.

# ---- what to run ----------------------------------------------------------------------------------------------------
PIPELINE=combined        # combined | L   (configs/pipelines/<name>.env)
LANGUAGE=auto            # auto (Whisper language ID) | hi | ... | none: chooses the target-voice pool refs/<lang>/
NUM_SPEAKERS=2           # speakers per recording (dataset/speakers.csv overrides it per sub-folder)
DIARIZE_BATCH=32         # DiariZen batch size: 32 needs ~11 GB of GPU memory; use 8 on an 8 GB GPU (~3 GB)
PROMPT_CAP=              # upper limit on the target prompt in seconds; empty = the pipeline's own (10 s combined, 25 s L)

# ---- dataset folders (cluster job; the UI takes the folder in its Dataset tab) -----------------------------------
DATASET_DIR=             # empty = <cluster root>/dataset; <DATASET_DIR>/<sub-folder>/<files>
OUT_DIR=                 # empty = <DATASET_DIR>_anonymized

# ---- where things are on this machine (empty = the default layout) -----------------------------------------------
SEEDVC_ROOT=             # Seed-VC checkout             (UI: C:\anon-local\seed-vc     cluster: <root>/repos/seed-vc)
MODELS_DIR=              # holds seedvc_stock/DiT_uvit_tat_xlsr_ema.pth  (UI: C:\anon-local\models  cluster: <root>/models)
HF_HOME=                 # Hugging Face model cache     (UI: C:\anon-local\hf_cache    cluster: <root>/hf_cache)
DIARIZEN_PYTHON=         # python of the DiariZen env, UI only (C:\anon-local\envs\diarizen\python.exe)
REF_DIR=                 # target-voice pool             (refs/ in the project)

# ---- demo UI -------------------------------------------------------------------------------------------------------
PORT=7860
DEMO_OUT_DIR=            # where the UI writes its results (results/demo)
