# Pipeline "L": Seed-VC V1 44.1 kHz generator with F0 conditioning and the Whisper-small content encoder; target voice
# of the same gender with the nearest median pitch.
# Read by src/anonymize.py --profile, the demo UI and jobs/anonymize_dataset.sbatch (PIPELINE=L).
PIPELINE_NAME=L
OUT_TAG=L
MODEL=v1
CKPT=                                                          # empty = Seed-VC's default F0 checkpoint (seed-uvit-whisper-base-f0-44k)
CFG_YML=
F0=true
REF_STRATEGY=pitch                                             # same gender, nearest median pitch
MAX_SPEAKERS=0                                                 # no cap beyond the diarizer's own
STEPS=25                                                       # denoising steps
CFG=0.7                                                        # classifier-free guidance
REF_SEC=25                                                     # target prompt length (s)
CTX=2                                                          # context around a turn (s)
