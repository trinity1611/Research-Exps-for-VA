# Pipeline "combined" (default): Seed-VC V1 with the stock XLS-R "tiny" DiT and the BigVGAN v2 22 kHz vocoder, no
# pitch branch; target voice of the same pitch class with the least similar timbre; at most 2 voices per file.
# Read by src/anonymize.py --profile, the demo UI and jobs/anonymize_dataset.sbatch (PIPELINE=combined).
# ${PIPE} = project root, ${MODELS_DIR} = the folder holding seedvc_stock/ (MODELS_DIR in configs/run.env).
PIPELINE_NAME=combined
OUT_TAG=combined
MODEL=v1
CKPT=${MODELS_DIR}/seedvc_stock/DiT_uvit_tat_xlsr_ema.pth        # Seed-VC stock XLS-R "tiny" DiT (released weights)
CFG_YML=${PIPE}/configs/models/xlsr_tiny_bigvgan_v2_8k.yml     # its config with the BigVGAN v2 22 kHz fmax-8k vocoder
F0=false                                                       # this generator has no pitch branch
REF_STRATEGY=timbre_far                                        # same pitch class as the speaker, least similar CAM++ timbre
MAX_SPEAKERS=2                                                 # a 3rd diarization cluster is merged into the closest voice
STEPS=30                                                       # denoising steps
CFG=1.0                                                        # classifier-free guidance
REF_SEC=10                                                     # target prompt length (s)
CTX=3                                                          # context around a turn (s)
